#include <Arduino.h>
#include <WiFi.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <time.h>
#include <HTTPClient.h>  // 新增的库
#include <freertos/FreeRTOS.h>  // 使用FreeRTOS（实时操作系统），它是ESP32固件的一部分，来创建多个任务
#include <freertos/task.h>

// 配置 OLED
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

// GPIO 定义
#define WAVE_INPUT_GPIO 16
#define BUTTON_PIN 0

// WiFiServer 是 ESP32 Wi-Fi 库 中的一个类，用于创建和管理基于 Wi-Fi 的 TCP 服务器
WiFiServer server(80); // 创建 HTTP 服务器，HTTP 通信的默认端口是 80

// 连接到外部 wifi
const char* RouterSSID = "Hyperoptic Fibre 9803";
const char* RouterPassword = "A8848484HaK73H";
bool statu = false;  // 用于检查外部wifi连接状态

// InfluxDB 连接参数 (适用于 InfluxDB 2.x 和 cloud)
const char* influxdbUrl = "https://eu-central-1-1.aws.cloud2.influxdata.com/api/v2/write?org=Frequency_detect_monitor&bucket=get_started&precision=ms"; // my 数据库 URL //结尾加上&precision=s则写入数据的最后必须是一个秒级整数
const char* measurement = "frequency_data";  // 想要存储数据的 measurement 名称

// 频率存储配置
#define MAX_STORED_FREQUENCIES 1500
volatile uint32_t timeArray[10] = {0};
volatile int count = 0;
volatile bool newTimeAvailable = false;
volatile float frequency = 0.0;
volatile uint32_t lastInterruptTime = 0;

// 存储 “频率 + 时间戳” 的结构体
struct FrequencyData {
    float frequency;
    time_t timestamp;  // 时间戳使用time_t类型
};
FrequencyData storedFrequencies[MAX_STORED_FREQUENCIES] = {0};
volatile int storedIndex = 0; // 存入结构体
volatile int sendIndex = 0;   // 从结构体传到数据库
bool displayStored = false;
bool buttonPressed = false;
volatile bool lastSignalState = LOW;  // last信号状态
volatile uint32_t lastDebounceTime = 0;  // 上次信号变化的时间
const uint32_t debounceDelay = 200;  // 去抖动延迟时间，单位为微秒

// GPIO 上升沿视去抖动
IRAM_ATTR void gpio_isr_handler() {
    uint32_t currentTime = micros();
    bool currentSignalState = digitalRead(WAVE_INPUT_GPIO);

    // 去抖动：最近一次信号状态变化过200微秒
    if (currentSignalState != lastSignalState && (currentTime - lastDebounceTime) > debounceDelay) {
        lastDebounceTime = currentTime;

        // 检测到突发的上升沿
        if (lastSignalState == LOW && currentSignalState == HIGH) {
            count++;
            if (count == 20) {  // 每20个上升沿
                timeArray[0] = currentTime;
                newTimeAvailable = true;
                count = 0;
            }
        }
        lastSignalState = currentSignalState;  // 更新上次信号状态
    }
}

// 按键中断处理：切换显示模式
void IRAM_ATTR button_isr_handler() {
    buttonPressed = true;
}

void setup() {
    // 初始化串口和 GPIO
    Serial.begin(115200);
    pinMode(WAVE_INPUT_GPIO, INPUT);
    pinMode(BUTTON_PIN, INPUT_PULLUP);
    attachInterrupt(WAVE_INPUT_GPIO, gpio_isr_handler, CHANGE);
    attachInterrupt(BUTTON_PIN, button_isr_handler, FALLING);

    // 初始化 OLED
    if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
        Serial.println("OLED initialization failed");
        for (;;);
    }
    display.clearDisplay();
    display.setTextSize(1);  // 设置文本大小
    display.setTextColor(SSD1306_WHITE);  // 设置文本颜色为白色
    display.setCursor(0, 0);  // 设置光标位置
    display.display();

    // 设置 Wi-Fi 热点，同时连接到外界 wifi station
    WiFi.mode(WIFI_STA);
    Serial.println("Wi-Fi started");
    WiFi.begin(RouterSSID, RouterPassword);  // 连接到外部wifi
    server.begin(); // 启动 HTTP 服务器

    // 从一个网络时间协议（NTP）服务器来同步esp32的时间
    configTime(0, 3600, "pool.ntp.org", "time.nist.gov");  // 配置 ESP32 的时间设置；从 NTP 服务器获取当前时间，设置时区为 UTC+0
    struct tm timeinfo;  // 这行代码声明了一个 struct tm 类型的变量 timeinfo；struct tm 是 C 和 C++ 中的一个结构体，用于存储时间和日期信息，通常包括年、月、日、小时、分钟和秒等组件

    // create FreeRTOS任务
    xTaskCreate(databaseWriteTask, "Database Write Task", 4096, NULL, 1, NULL);
}

// 计算队列中尚未发送的数据个数
int getStoredCount() {
  // 注意：为简化演示，未做原子性保护。若要严格防并发，可加临界区。
  if (storedIndex >= sendIndex) {
    return storedIndex - sendIndex;
  } else {
    return MAX_STORED_FREQUENCIES - (sendIndex - storedIndex);
  }
}

// FreeRTOS任务：定时将频率和时间戳写入数据库 
void databaseWriteTask(void *parameter) {
  // 每隔5秒写一次数据库
    const TickType_t writeInterval = pdMS_TO_TICKS(5000); // wait 5s

    while (true) {
      vTaskDelay(writeInterval);
        if (WiFi.status() == WL_CONNECTED) {

          int countToSend = getStoredCount();
          if (countToSend == 0) {
            Serial.println("[DB Task] No data to send.");
            continue;
          }

          // 临时变量，用来从 sendIndex 遍历到 storedIndex
          int tempRead = sendIndex;
          String postData;

          for (int i = 0; i < countToSend; i++) {
            FrequencyData &fd = storedFrequencies[tempRead];
            // 将 Unix time_t 转换成本地时间结构
            struct tm timeinfo;
            localtime_r(&fd.timestamp, &timeinfo);

            // 将本地时间格式化成 "YYYY-MM-DD HH:MM:SS"
            char stamp[20]; 
            strftime(stamp, sizeof(stamp), "%Y-%m-%d %H:%M:%S", &timeinfo);

            // 计算毫秒级epoch：秒 * 1000 + 当前毫秒(0~999)
            uint64_t msEpoch = (uint64_t)fd.timestamp * 1000ULL + (millis() % 1000);

            postData += String(measurement) + ",device=ESP32 frequency=" + String(fd.frequency,3) + ",stamp=\"" + String(stamp) + "\" " + String(msEpoch) + "\n"; // 结尾不能有空格
            tempRead = (tempRead + 1) % MAX_STORED_FREQUENCIES;
          }

          // 发送 HTTP POST
          HTTPClient http;
          http.begin(influxdbUrl);
          http.addHeader("Content-Type", "text/plain"); // 设置内容类型为纯文本
          http.addHeader("Authorization", "Token s33wXkf6hb7JiLMGuD8kwnQtwgcXoxK-v2uu1AKmBV7_eikAS8cu2i00D0dxl6P9BNNONlc2dDb8sHEuz387TA=="); // 添加 API 令牌
          Serial.println("[DB Task] Sending batch data:\n" + postData);
          int httpResponseCode = http.POST(postData);  

          if (httpResponseCode == 204) {
              Serial.println("[DB Task] Data written to InfluxDB successfully!\n\n");
              // 发送成功后，移动 readIndex，表示这些数据已完成发送
              sendIndex = (sendIndex + countToSend) % MAX_STORED_FREQUENCIES;
          } else {
              Serial.println("[DB Task] Error sending data: " + String(httpResponseCode));
              String response = http.getString();
              Serial.println("InfluxDB response body: " + response);
          }

          http.end();
        }
    }
}

void loop() {
    static uint32_t lastTime = 0;  // 只在第一次进入loop时初始化为0
    unsigned long current_Time = millis();

    // 实时计算频率
    if (newTimeAvailable) {
        uint32_t newTime = timeArray[0];
        newTimeAvailable = false;

        if (lastTime != 0) {
            uint32_t timeDiff = newTime - lastTime;
            frequency = 1e6 / (timeDiff / 10.0);

            struct tm timeinfo;
            if (!getLocalTime(&timeinfo)) {
                Serial.println("Failed to get NTP time");
                return;
            }
            time_t now;
            time(&now);  // 获取当前时间戳

            // 保存新的频率和时间戳（循环覆盖）
            storedFrequencies[storedIndex].frequency = frequency;
            storedFrequencies[storedIndex].timestamp = now;

            storedIndex = (storedIndex + 1) % MAX_STORED_FREQUENCIES;
        }
        lastTime = newTime;
    }

    // 按键切换显示模式
    if (buttonPressed) {
        displayStored = !displayStored;
        buttonPressed = false;
    }
    
    // 持续检查 esp32 是否正确连接到外部 wifi
    if (WiFi.status() == WL_CONNECTED && statu == false) {
      Serial.println("Connected to external WiFi");
      Serial.println("IP Address: " + WiFi.localIP().toString());
      statu = true;  // 确保当esp32一直正确连接外部wifi时，只输出一次 ip address
    }
    if (WiFi.status() != WL_CONNECTED) {
      Serial.println("Failed/Waited to connect to external WiFi");
      WiFi.begin(RouterSSID, RouterPassword);  // 重新连接外部wifi
      statu = false;
    }

    // 更新 OLED 显示
    updateOLED();

}

void updateOLED() {
    display.clearDisplay();

    char formattedDate[64];
    struct tm timeinfo;
    if (!getLocalTime(&timeinfo)) {
        strcpy(formattedDate, "Time not set");
    } else {
        strftime(formattedDate, sizeof(formattedDate), "%d-%m-%Y %H:%M:%S", &timeinfo);
    }

    if (!displayStored) {
        // 实时显示频率
        display.setCursor(0, 0);
        display.print("Real-time Frequency:");
        display.setCursor(0, 10);
        display.print(frequency, 3);
        display.print(" Hz");
        display.setCursor(0, 20);
        display.print(formattedDate); // 显示当前时间
    } else {
        // 显示存储的频率列表
        display.setCursor(0, 0);
        display.print("Stored Frequencies:");
        for (int i = 0; i < MAX_STORED_FREQUENCIES; i++) {
            display.setCursor(0, 10 + i * 20);
            display.printf("%d: %.3f Hz", i + 1, storedFrequencies[i].frequency);
            display.setCursor(0, 20 + i * 20); // Set cursor for date, right below the frequency
            strftime(formattedDate, sizeof(formattedDate), "%d-%m-%Y %H:%M:%S", localtime(&storedFrequencies[i].timestamp));
            display.print(formattedDate);
        }
    }

    display.display();
}
